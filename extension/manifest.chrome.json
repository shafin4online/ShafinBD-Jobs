{
  "manifest_version": 3,
  "name": "ShafinBD Jobs - Teletalk AutoFill Extension",
  "short_name": "ShafinBD AutoFill",
  "author": "ShafinBD",
  "version": "1.0.0",
  "description": "ShafinBD Jobs পোর্টালের প্রোফাইল ডাটা দিয়ে Teletalk (*.teletalk.com.bd) সরকারি চাকরির আবেদন ফরম ১-ক্লিকে পুরনের জন্য এক্সটেনশন।",
  "homepage_url": "https://www.jobs.shafinbd.com/#/privacy",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ShafinBD Jobs AutoFiller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.teletalk.com.bd/*",
    "https://www.jobs.shafinbd.com/*",
    "https://jobs.shafinbd.com/*",
    "https://shafinbd.vercel.app/*",
    "*://*.run.app/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "externally_connectable": {
    "matches": [
      "https://www.jobs.shafinbd.com/*",
      "https://jobs.shafinbd.com/*",
      "https://shafinbd.vercel.app/*",
      "*://*.run.app/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*"
    ]
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.teletalk.com.bd/*"
      ],
      "js": [
        "utils/browser-polyfill.js",
        "mapping/teletalk.js",
        "engine/validator.js",
        "engine/formatter.js",
        "engine/uploader.js",
        "engine/autofill-engine.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.jobs.shafinbd.com/*",
        "https://jobs.shafinbd.com/*",
        "https://shafinbd.vercel.app/*",
        "*://*.run.app/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "utils/browser-polyfill.js",
        "bridge/web-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
