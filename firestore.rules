rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'shafinbd4u@gmail.com' ||
        request.auth.token.email.lower() == 'admin@shafinbd.com' ||
        request.auth.token.admin == true
      );
    }

    // Question Bank: Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Question Bank: Topics
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Question Bank: Subtopics
    match /subtopics/{subtopicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Question Bank: Questions
    match /questions/{questionId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Question Bank: Import Logs
    match /questionImports/{importId} {
      allow read, write: if isAdmin();
    }

    // User Data & Subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Student Question Reading / Practice Progress
      match /questionProgress/{questionId} {
        allow read, write: if isOwner(userId);
      }

      // Student Aggregated Subject Stats (O(1) dashboard reads)
      match /progressStats/{subjectId} {
        allow read, write: if isOwner(userId);
      }

      // Student Favorite / Bookmarked Questions
      match /favorites/{questionId} {
        allow read, write: if isOwner(userId);
      }

      // Student Quiz Attempts & Test History
      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(userId);

        // Immutably snapshotted questions subcollection
        match /questions/{questionId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Jobs & Applications (Existing System)
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
